{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "RP2350 (core0) OpenOCD",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "openocd",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/derived/drv_rel/rp2350_driver.elf",
            "runToEntryPoint": "main",
            "openOCDLaunchCommands": [
                "gdb port 50000",
                "tcl port 50001",
                "telnet port 50002",
                "adapter speed 5000",
                "transport select swd"
            ],

            "configFiles": [
                "interface/cmsis-dap.cfg",
                "target/rp2350.cfg"
                //"${workspaceFolder}/weact-openocd.cfg"
            ],

            "preLaunchCommands": [
                "monitor reset halt"
            ],
            "postLaunchCommands": [
                "monitor reset init"
            ],

            "rttConfig": {
                "enabled": true,
                "address": "auto",
                "rtt_start_retry": 250,
                "polling_interval": 20,
                "searchId": "SEGGER RTT",
                "decoders": [
                    {
                        "label": "RTT0",
                        "port": 0,
                        "type": "console"
                    }
                ]
            }

            // core (targetId) selection, probably not needed
            // "targetId": "rp2350.dap.core0"
            // "targetId": "rp2350.cm0"
            //"targetProcessor": 0
        },
        {
            "type": "dezog",
            "request": "launch",
            "name": "Internal ZX Simulator : dezog / zsim",
            "remoteType": "zsim",
            "zsim": {
                //"preset": "spectrum",
                //"memoryModel": "ZX48K",
                //"memoryModel": "RAM",
                "cpuFrequency": 35000000,
                "limitSpeed": false,
                "customCode": {
                    "debug": false, // add UI to debug the js code
                    "jsPath": "${workspaceFolder}/z80_con.js",
                    //"uiPath": "z80_con.html",
                },
            },
            "sjasmplus": [
                {
                    "path": "derived/drv_dbg/zexall.sld"
                }
            ],
            "loadObjs": [
                { "path": "derived/drv_dbg/zexall.bin", "start": "0x100" }
            ],
            "startAutomatically": false,
            "commandsAfterLaunch": [],
            "rootFolder": "${workspaceFolder}",
            "execAddress": "0x100",
            //"topOfStack": "stack_top",
            //"load": "z80-opcode-tester.sna",
            "tmpDir": ".zxtmp"
        }
    ]
}