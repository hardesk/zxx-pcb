{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build asynchronous WAIT driver",
            "type": "process",
            "command": "make",
            "args": [
                "build",
                "BUS_MODE=ASYNC",
                "BUILD_TYPE=Release",
                "BUILD_DIR=derived/drv_rel",
                "Z80_CLOCK_HZ=1000000"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
