; Asynchronous Z80 bus: WAIT starts and idles high.
; Guard asserts on RD/IORQ independently of detector/service and CLK;
; memory writes are posted (no WAIT, no reply).
; Guard IN_BASE=IORQ: low four bits are IORQ, MREQ, RD, WR.
; Detector RX carries accepted snapshots; service TX carries replies.
; DATA_READY is PIO1 IRQ3.
.program z80_async_clock
.side_set 1
.wrap_target
    nop side 1
    nop side 0
.wrap

.program z80_async_guard
.pio_version 1
; WAIT is asserted only for transfers that need a reply: RD (memory or I/O
; read, opcode fetch) and IORQ (I/O and interrupt acknowledge). A memory
; write (MREQ+WR) is posted by the detector and refresh needs no reply, so
; MREQ alone never stalls the CPU. RD falls with MREQ, so reads still assert
; WAIT immediately.
.wrap_target
    set pins, 1 ; pins for set is configured to be WAIT
scan_request:
    mov osr, ~pins ; IN_BASE=IORQ: bit0 IORQ, bit1 MREQ, bit2 RD, bit3 WR
    out x, 1 ; IORQ
    jmp x-- assert_wait
    jmp pin scan_request ; JMP_PIN=RD: high (idle) keeps scanning; MREQ alone
                         ; (posted write or refresh) never asserts WAIT
assert_wait:
    set pins, 0
pending_reply:
    mov x, status ; status is non-zero if IRQ is set for this SM
    jmp !x check_request ; still processing busreq (do we really need this?)
    irq clear 3 ; deassert IRQ signal and...
    set pins, 1 ; ...deassert WAIT
wait_end:
    mov osr, ~pins
    out x, 4
    jmp x-- wait_end
    jmp scan_request
check_request:
    mov osr, ~pins
    out x, 4
    jmp x-- pending_reply
    ; Strobes ended without DATA_READY (RESET abort). Return to high idle.
.wrap

.program z80_async_detector
.pio_version 1
; Snapshot bits 27..31 = M1, IORQ, MREQ, RD, WR (active low on the pins).
; A plain memory write (MREQ+WR only) is posted: pushed with no reply and no
; WAIT. Everything else that needs a reply is pushed and the detector waits
; for the service SM to retire the cycle (IRQ5). Writes and requests share
; the RX FIFO, so the M33 handles them in bus order. At most two posted
; writes precede the next read (PUSH, CALL, INTA/NMI), and that read waits
; until the FIFO is drained, so the FIFO cannot fill.
.wrap_target
scan:
    wait 1 gpio 25 ; /RESET: ignore all requests while reset is asserted
    mov isr, pins
    mov osr, ~isr
    out null, 27
    out x, 5 ; WR|RD|MREQ|IORQ|M1, active high
    jmp !x scan
    set y, 20 ; MREQ+WR alone
    jmp x!=y sync_request
    push block ; posted memory write
    wait 1 gpio 29 ; until /MREQ rises
    jmp scan
sync_request:
    mov osr, ~isr
    out null, 28
    out y, 2 ; IORQ|MREQ
    jmp !y scan
    out y, 2 ; RD|WR
    jmp y-- request
    ; No RD/WR: only a coherent M1+IORQ snapshot is an acknowledgement.
    set y, 3
    jmp x!=y scan
request:
    push block ; accepted detector snapshot to the M33
    wait 1 irq 5 ; Wait until the bus request finishes
.wrap

.program z80_async_bus
.pio_version 1
; One reply per synchronous request; posted writes get none. The M33 writes
; a reply only after reading its request, so blocking on PULL is the start
; signal. Detector (21) + service (11) fill PIO0's 32 words.
.wrap_target
    pull block
    out pins, 8
    out pindirs, 8 [4]
    ; The WAIT guard may release WAIT only after these outputs have settled.
    irq next 3
end_cycle:
    ; Keep ownership while ANY request/transfer strobe remains asserted.
    ; This also covers IORQ-only interrupt acknowledgement, WR pulses during
    ; a held MREQ, and RD outliving a short MREQ deassertion.
    mov osr, ~pins
    out null, 28
    out x, 4 ; IORQ|MREQ|RD|WR
    jmp x-- end_cycle
    ; Snapshot/poll latency provides hold time beyond the observed bus end.
    mov pindirs, null
    ; RESET can end the transfer before its reply arrives. In that case the
    ; guard has already returned to idle and never consumes DATA_READY.
    ; Retire this reply before rearming the detector for the next transfer.
    irq next clear 3
    irq 5 ; Make detector know that bus request has finished
.wrap
